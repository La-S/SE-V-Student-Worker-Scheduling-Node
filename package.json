    "@types/express": "^5.0.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^170.1.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.1",
    "sequelize": "^6.37.7",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10"
  }
