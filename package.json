{
  "type": "module",
  "name": "student-worker-scheduling-backend",
  "version": "1.0.0",
  "description": "A Node.js Rest API for Student Worker Scheduling",
  "main": "server.ts",
  "scripts": {
    "test": "jest --",
    "start": "tsx server.ts",
    "dev": "NODE_ENV=dev tsx server.ts",
    "devinsecure": "cross-env USE_HTTP=true NODE_ENV=dev tsx server.ts",
    "bundle": "mkdir deploy && cp -r app server.ts package.json package-lock.json workerscheduling-t3-backend.service .env deploy"
